      "recommendedStyleCategories": ["人像宠物", "线描手稿", "插画卡通", "水彩油画"],
      "avoidStyleCategories": ["原始3D风格"],
      "warnings": [
        "人像/宠物场景下要重点检查脸部与关键识别特征。"
      ]
