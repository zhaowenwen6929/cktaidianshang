    "通用": {
      "prompt": "按通用风格转绘标准执行，优先保证主体保真、风格明确和可用性稳定。",
      "required": ["主体保真", "风格命中明确", "输出可直接使用"],
      "forbidden": ["主体漂移", "风格混乱", "输出不稳定"],
      "recommendedStyleCategories": ["设计风格", "插画卡通", "线描手稿"],
      "avoidStyleCategories": [],
      "warnings": [
        "未识别品类时优先使用结构风险较低的分类。"
      ]
