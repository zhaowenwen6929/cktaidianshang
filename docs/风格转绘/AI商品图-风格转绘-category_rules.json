  "validationRules": [
    {
      "when": {
        "productCategory": "家电数码类",
        "video2d3dStyleCategory": "人像宠物"
      },
      "level": "warn",
      "message": "家电数码类默认不建议使用“人像宠物”分类，除非素材本身就是人像/宠物主体。"
    },
    {
      "when": {
        "productCategory": "铁艺图形/五金",
        "video2d3dStyleCategory": "水彩油画"
      },
      "level": "warn",
      "message": "铁艺图形/五金场景下水彩油画类风格容易弱化结构硬度，建议确认是否符合预期。"
    },
    {
      "when": {
        "productCategory": "服装/纺织",
        "video2d3dStyleCategory": "原始3D风格"
      },
      "level": "warn",
      "message": "服装/纺织场景下原始3D风格容易破坏面料语义，建议优先使用工艺材质、插画卡通或线描手稿。"
    }
  ]
