{
  "meta": {
    "toolKey": "goods-marketing",
    "name": "一键营销主图平台规则",
    "version": "1.0.0",
    "updatedAt": "2026-05-08",
    "ruleLevelDefinition": {
      "A": "官方公开规则明确可引用",
      "B": "官方公开信息可间接约束",
      "C": "公开信息不完整，按跨平台保守策略执行"
    },
    "defaultPolicy": "跨平台保守合规：真实展示、主体可识别、信息不误导、避免侵权、避免遮挡主体关键结构。"
  },
  "platformRules": {
    "全平台通用（16平台）": {
      "ruleLevel": "A",
      "prompt": "营销主图可承载卖点，但必须保证商品主体完整可识别、信息层级清晰、表达真实不误导。",
      "required": [
        "商品主体清晰完整",
        "信息可读且层级明确",
        "卖点与实物一致",
        "无侵权元素"
      ],
      "forbidden": [
        "虚假功效",
        "绝对化承诺",
        "联系方式/二维码/导流信息",
        "遮挡主体关键结构"
      ]
    },
    "淘宝": {
      "ruleLevel": "C",
      "prompt": "适配淘宝高密度浏览语境，允许营销表达但避免牛皮癣堆叠，优先保证主体识别与信息清晰。",
      "required": ["主体优先", "信息清晰", "利益点直观"],
      "forbidden": ["密集遮挡文案", "虚假承诺", "侵权元素"]
    },
    "天猫": {
      "ruleLevel": "C",
      "prompt": "适配天猫品牌化展示语境，营销表达需兼顾品牌质感和转化效率。",
      "required": ["品牌感统一", "主体完整", "信息层级清楚"],
      "forbidden": ["低质贴图感", "过度噪声化拼贴", "误导文案"]
    },
    "京东": {
      "ruleLevel": "C",
      "prompt": "适配京东效率型决策语境，强调结构清晰、可信表达与核心卖点直达。",
      "required": ["结构可辨", "主体清晰", "卖点可读"],
      "forbidden": ["夸张不实活动信息", "过度遮挡", "侵权标识"]
    },
    "拼多多": {
      "ruleLevel": "C",
      "prompt": "适配拼多多快速决策语境，突出核心利益点但避免信息过载。",
      "required": ["一眼识别主体", "核心利益点聚焦", "信息清晰"],
      "forbidden": ["无关视觉噪声过多", "误导性低价承诺", "遮挡商品主体"]
    },
    "1688": {
      "ruleLevel": "C",
      "prompt": "适配1688商采语境，营销信息应服务规格、材质、供货价值表达。",
      "required": ["参数与结构可信", "主体清晰", "规格信息可读"],
      "forbidden": ["纯情绪化营销覆盖商品信息", "虚构参数", "侵权素材"]
    },
    "抖音电商": {
      "ruleLevel": "C",
      "prompt": "适配抖音电商内容化浏览，强调首眼吸引与真实可识别平衡。",
      "required": ["吸引力与真实性平衡", "主体完整", "文案简洁"],
      "forbidden": ["重滤镜导致失真", "夸张效果误导", "遮挡主体关键部件"]
    },
    "快手电商": {
      "ruleLevel": "C",
      "prompt": "适配快手电商真实交易氛围，营销表达应直接、可信、不过度包装。",
      "required": ["可信表达", "主体突出", "卖点直达"],
      "forbidden": ["娱乐化喧宾夺主", "虚假背书", "过度后期失真"]
    },
    "小红书电商": {
      "ruleLevel": "B",
      "prompt": "适配小红书电商审美型种草语境，营销表达可审美化但需真实可核验。",
      "required": ["审美统一", "主体可识别", "信息克制可读"],
      "forbidden": ["硬广贴片过重", "夸张功效", "遮挡商品关键结构"]
    },
    "亚马逊": {
      "ruleLevel": "A",
      "mainImagePolicy": "严格",
      "prompt": "适配亚马逊商品图规范：若用于主图，必须纯白背景并仅展示售卖商品本体；营销文案和促销角标不应出现在主图。若需要营销表达，应用于附图/A+内容图。",
      "required": [
        "主图纯白背景（RGB 255,255,255）",
        "仅展示售卖商品本体",
        "主体占图主要区域",
        "真实准确反映商品"
      ],
      "forbidden": [
        "主图文字/Logo/水印/边框",
        "主图促销角标",
        "误导性文案",
        "与实物不符渲染"
      ]
    },
    "Temu": {
      "ruleLevel": "C",
      "prompt": "适配Temu快节奏展示语境，强调主体清晰、卖点直观、版面干净。",
      "required": ["主体完整可识别", "卖点直达", "信息不拥挤"],
      "forbidden": ["噪声化拼贴", "虚假促销承诺", "遮挡主体"]
    },
    "TikTok Shop": {
      "ruleLevel": "A",
      "mainImagePolicy": "严格",
      "prompt": "适配TikTok Shop商品图规范：主图应为纯白/纯色合规背景并客观展示商品，不得含覆盖性文案与水印。营销强化内容建议用于非首图。",
      "required": [
        "主图客观展示商品",
        "图片清晰且不失真",
        "商品与实际售卖一致",
        "主体不被遮挡"
      ],
      "forbidden": [
        "主图覆盖文字/Logo/水印/边框",
        "误导性演示",
        "与实物不一致内容",
        "明显夸张功效承诺"
      ]
    },
    "阿里国际站": {
      "ruleLevel": "B",
      "prompt": "适配阿里国际站B2B采购语境，营销内容应强化专业可信与规格可读性。",
      "required": ["专业可信", "规格参数可读", "主体清晰"],
      "forbidden": ["弱化规格信息", "夸大承诺", "侵权元素"]
    },
    "速卖通": {
      "ruleLevel": "C",
      "prompt": "适配速卖通跨境零售语境，突出真实卖点和可读信息，不做不实承诺。",
      "required": ["真实卖点", "主体优先", "信息简洁"],
      "forbidden": ["夸张承诺", "过密小字堆叠", "遮挡商品主体"]
    },
    "Shopee": {
      "ruleLevel": "C",
      "prompt": "适配Shopee移动端浏览语境，营销元素应克制，确保主商品优先识别。",
      "required": ["主体优先", "信息可读", "画面整洁"],
      "forbidden": ["贴纸边框吞没主体", "误导文案", "无关元素堆叠"]
    },
    "OZON": {
      "ruleLevel": "B",
      "prompt": "适配OZON商品展示语境，强调清晰、真实、可读，不使用重后期失真效果。",
      "required": ["真实细节", "主体完整", "层级清晰"],
      "forbidden": ["重后期失真", "夸张误导", "遮挡主体细节"]
    },
    "SHEIN": {
      "ruleLevel": "C",
      "prompt": "适配SHEIN时尚零售语境，营销主图应兼顾时尚审美与商品真实呈现。",
      "required": ["版型真实", "主体完整", "信息简洁可读"],
      "forbidden": ["版型失真", "过度修饰导致失真", "误导承诺"]
    }
  }
}
