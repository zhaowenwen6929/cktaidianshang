{
  "toolKey": "goods-bg",
  "version": "2026-05-09",
  "platformRulesByTool": {
    "全平台通用（16平台）": {
      "ruleLevel": "A",
      "prompt": "面向多平台通用投放，换背景结果需优先保证主体完整、背景克制、信息真实，不使用夸张广告特效替代商品展示。",
      "required": ["主体完整", "背景服务主体", "光影融合真实"],
      "forbidden": ["背景抢主体", "结构失真", "不真实反射"]
    },
    "亚马逊": {
      "ruleLevel": "A",
      "prompt": "若作为 Amazon 主图，必须纯白背景（RGB 255,255,255），仅展示实际售卖商品，不添加文字、Logo、水印、边框和非售卖配件。",
      "required": ["主图白底合规", "主体完整", "商品真实可售"],
      "forbidden": ["文字覆盖", "非售卖元素", "夸张特效"]
    },
    "TikTok Shop": {
      "ruleLevel": "A",
      "prompt": "若作为 TikTok Shop 首图，优先纯白背景与主体高识别；非白底场景应作为附图语义，不得冒充首图。",
      "required": ["首图高识别", "主体清晰完整", "信息不误导"],
      "forbidden": ["复杂背景喧宾夺主", "封面党夸张效果", "违规引导元素"]
    },
    "Temu": {
      "ruleLevel": "B",
      "prompt": "适配 Temu 快节奏浏览语境，背景应简洁可辨，优先保证主体和商品信息识别效率。",
      "required": ["主体高识别", "背景干净", "结构真实"],
      "forbidden": ["背景过度花哨", "主体边缘糊化", "道具误导"]
    },
    "抖音电商": {
      "ruleLevel": "B",
      "prompt": "适配抖音电商内容流浏览，换背景可有氛围但不得牺牲主体识别与商品真实性。",
      "required": ["主体清楚", "背景有语义", "整体真实"],
      "forbidden": ["娱乐化抢主体", "特效压商品", "虚假展示"]
    },
    "小红书电商": {
      "ruleLevel": "B",
      "prompt": "适配小红书审美化种草语境，可适度强化生活方式氛围，但必须保持商品版型和材质真实。",
      "required": ["审美统一", "商品保真", "可读可辨"],
      "forbidden": ["重滤镜失真", "背景脏乱", "主体被吞没"]
    },
    "淘宝": {
      "ruleLevel": "B",
      "prompt": "适配淘宝商品图语境，换背景应兼顾点击吸引与信息清晰，主体必须完整，禁止误导性表达。",
      "required": ["主体完整", "画面清晰", "商品与背景关系自然"],
      "forbidden": ["过度拼贴", "细节遮挡", "失真过修"]
    },
    "京东": {
      "ruleLevel": "B",
      "prompt": "适配京东偏理性决策语境，背景风格应克制，重点突出商品结构、材质和品质可信度。",
      "required": ["结构可辨", "材质可信", "画面干净"],
      "forbidden": ["背景噪声过重", "结构变形", "夸大渲染"]
    }
  }
}
